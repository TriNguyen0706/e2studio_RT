{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "vendor": {
    "renesas": {
      "renesasPresetVersion": 1
    }
  },
  "$comment": "Check EnviromentSetupConfig preset for setting the environment variables for toolchain and FSP Smart Configurator",
  "configurePresets": [
    {
      "name": "EnviromentSetupConfig",
      "hidden": true,
      "inherits": "OSConfig",
      "toolchainFile": "${sourceDir}/cmake/gcc.cmake",
      "environment": {
        "ARM_GCC_TOOLCHAIN_PATH": "$penv{ARM_GCC_TOOLCHAIN_PATH}",
        "RASC_EXE_PATH": "$penv{RASC_EXE_PATH}",
        "NINJA_PROGRAM": "ninja"
      },
      "cacheVariables": {
        "CMAKE_MAKE_PROGRAM": "$env{NINJA_PROGRAM}",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/gcc.cmake"
      }
    },
    {
      "name": "BaseConfig",
      "hidden": true,
      "environment": {
        "EXE_SUFFIX": ""
      }
    },
    {
      "name": "OSConfig",
      "inherits": "BaseConfig",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "environment": {
        "EXE_SUFFIX": ".exe"
      }
    },
    {
      "name": "Debug",
      "inherits": "EnviromentSetupConfig",
      "displayName": "Debug",
      "description": "Debug build using Ninja generator",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Release",
      "inherits": "EnviromentSetupConfig",
      "displayName": "Release",
      "description": "Release build using Ninja generator",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "configurePreset": "Debug"
    },
    {
      "name": "Release",
      "configurePreset": "Release"
    }
  ]
}
